{
  "name": "tokyo-bike-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler dev",
    "build": "npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy:cloudflare": "npm run check:launch && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tokyo-bike-map-stats --local",
    "db:migrate:remote": "wrangler d1 migrations apply tokyo-bike-map-stats --remote",
    "test": "npm run test:classifier && npm run test:conflation && npm run test:schema && npm run test:parking && npm run test:i18n && npm run test:detail && npm run test:destination && npm run test:feedback && npm run test:seo && npm run test:launch-config && npm run test:monetization",
    "test:classifier": "tsx scripts/osm/classifier.test.ts",
    "test:conflation": "tsx scripts/osm/conflate.test.ts",
    "test:schema": "tsx scripts/data-schema.test.ts",
    "test:parking": "tsx scripts/parking-schema.test.ts",
    "test:i18n": "tsx scripts/i18n.test.ts",
    "test:detail": "tsx scripts/detail-panel.test.ts",
    "test:destination": "tsx scripts/destination-search.test.ts",
    "test:feedback": "tsx scripts/feedback.test.ts",
    "test:seo": "tsx scripts/seo.test.ts",
    "test:launch-config": "tsx scripts/launch-config.test.ts",
    "test:monetization": "tsx scripts/monetization.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "check:launch": "tsx scripts/check-launch.ts && npm test && npm run build",
    "validate:data": "tsx scripts/validate-data.ts",
    "ingest:osm": "tsx scripts/ingest-osm.ts",
    "import:parking": "tsx scripts/import-parking.ts",
    "import:official": "tsx scripts/import-official.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/shapefile": "^0.6.4",
    "csv-parse": "^7.0.2",
    "proj4": "^2.21.0",
    "shapefile": "^0.6.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.125.0"
  }
}
