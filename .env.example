# Optional overrides. Production defaults to Stadia Maps Alidade Smooth.
# Register every public hostname in the Stadia Maps dashboard before launch.
VITE_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
VITE_TILE_ATTRIBUTION="&copy; <a href='https://stadiamaps.com/' target='_blank' rel='noreferrer'>Stadia Maps</a> &copy; <a href='https://openmaptiles.org/' target='_blank' rel='noreferrer'>OpenMapTiles</a> &copy; <a href='https://www.openstreetmap.org/copyright' target='_blank' rel='noreferrer'>OpenStreetMap</a>"
VITE_TILE_MAX_ZOOM=20

# Optional override for destination search. The default uses Stadia Maps v2 geocoding.
VITE_GEOCODING_BASE_URL=https://api.stadiamaps.com/geocoding/v2

# Leave both empty until the site is approved in Google AdSense.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Recommended for scheduled build-time Overpass refreshes.
OSM_USER_AGENT=TokyoBikeMap/1.0 (+https://YOUR_DOMAIN; contact: YOUR_EMAIL)
