{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokyo-bike-map",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "tokyo-bike-map-stats",
      "database_id": "cb632c5b-132d-49de-b7d7-794466ce5bc7"
    }
  ]
}
