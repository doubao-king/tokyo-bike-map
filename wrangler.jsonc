{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tokyo-bike-map",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "manymao.com",
      "custom_domain": true
    },
    {
      "pattern": "tokyo-bike-map.manymao.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/area/*", "/parking/*"]
  },
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "tokyo-bike-map-stats",
      "database_id": "cb632c5b-132d-49de-b7d7-794466ce5bc7"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
